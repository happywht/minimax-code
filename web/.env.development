# Local dev defaults for the web client. Override per-developer by
# copying this file to `.env.development.local` and editing there.
#
# - VITE_AGENT_URL    base URL of the running Python agent. The
#                     agent binds 127.0.0.1:8765 by default; bump
#                     this if you launched with `--http-port`.
# - VITE_AGENT_MODE   set to "mock" to skip the /health probe and
#                     run the in-process mock backend (useful for
#                     UI work without the agent running). Leave
#                     empty (or unset) for auto-detect: probe
#                     /health, fall back to mock on failure.
VITE_AGENT_URL=http://127.0.0.1:8765
VITE_AGENT_MODE=
