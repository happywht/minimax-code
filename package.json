{
  "name": "minimax-code",
  "version": "0.17.0",
  "private": true,
  "description": "MiniMax Code web — React + Python agent",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm build && pnpm dev:agent",
    "dev:web": "pnpm --filter @minimax/web dev",
    "dev:agent": "node scripts/dev-agent.mjs",
    "build": "pnpm --filter @minimax/web build",
    "lint": "pnpm --filter @minimax/web lint",
    "test": "pnpm --filter @minimax/web test",
    "test:e2e": "playwright test",
    "py:install": "cd agent && uv sync",
    "py:run": "cd agent && uv run python -m minimax_code",
    "py:test": "cd agent && uv run pytest"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
