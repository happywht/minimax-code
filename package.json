{
  "name": "minimax-code",
  "version": "1.6.0",
  "private": true,
  "description": "MiniMax Code web — React + Python agent",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start-production.mjs",
    "dev:web": "pnpm --filter @minimax/web dev",
    "dev:agent": "node scripts/dev-agent.mjs",
    "build": "pnpm --filter @minimax/web build",
    "lint": "pnpm --filter @minimax/web lint",
    "test": "pnpm --filter @minimax/web test",
    "test:e2e": "playwright test",
    "verify:baseline": "node scripts/verify.mjs --suite=baseline --repeat=3",
    "verify:core": "node scripts/verify.mjs --suite=core",
    "verify:replay": "node scripts/verify.mjs --suite=replay",
    "verify:attachments": "node scripts/verify.mjs --suite=attachments",
    "verify:full": "node scripts/verify.mjs --suite=full",
    "py:install": "cd agent && uv sync",
    "py:run": "cd agent && uv run python -m minimax_code",
    "py:test": "cd agent && uv run pytest"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
