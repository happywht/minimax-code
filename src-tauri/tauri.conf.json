{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "MiniMax Code",
  "version": "0.1.0",
  "identifier": "com.minimax.code",
  "build": {
    "beforeDevCommand": "pnpm --filter @minimax/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @minimax/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MiniMax Code",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/minimax-code-agent"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI coding agent",
    "longDescription": "MiniMax Code desktop — AI coding agent with skills, scheduler, and multi-agent collaboration."
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
